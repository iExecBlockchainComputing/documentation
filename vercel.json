{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/get-started/welcome",
      "permanent": false
    },
    {
      "source": "/nox-protocol/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/nox-protocol",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "destination": "/robots-prod.txt",
      "has": [{ "type": "host", "value": "docs.iex.ec" }]
    },
    {
      "source": "/robots.txt",
      "destination": "/robots-dev.txt"
    },
    {
      "source": "/tools/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/overview/what-we-do",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/overview/helloWorld",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/overview/helloWorld/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/overview/use-case-demo",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/overview/use-case-demo/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/for-developers/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/for-workers/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/key-concepts/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/use-cases/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/help/:path*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/get-started/overview/iapp",
      "destination": "/get-started/overview/privacy-iapp",
      "permanent": true
    }
  ]
}
